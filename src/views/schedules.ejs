<%- include('partials/head') %>
<%- include('partials/nav') %>

<h1 class="mb-1 text-xl font-semibold">Schedules</h1>
<p class="mb-4 text-sm text-slate-500 dark:text-slate-400">Cron expressions run in <strong><%= timezone %></strong>. Placeholders: <code>{{group}}</code>, <code>{{date}}</code>, <code>{{time}}</code>, <code>{{schedule}}</code>.</p>

<section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">New schedule</h2>
  <form method="post" action="/schedules" class="grid gap-4 md:grid-cols-2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="block text-sm">
      <span class="font-medium">Group</span>
      <select name="groupId" required class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800">
        <% enabledGroups.forEach(function (g) { %>
          <option value="<%= g.id %>"><%= g.name %></option>
        <% }); %>
      </select>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Name</span>
      <input name="name" required placeholder="Daily check-in"
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800" />
    </label>
    <label class="block text-sm">
      <span class="font-medium">Cron</span>
      <input name="cron" required value="30 9 * * *" data-cron-input
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm dark:border-slate-700 dark:bg-slate-800" />
      <span class="mt-1 block text-xs text-slate-500 dark:text-slate-400" data-cron-preview>Every day at 09:30</span>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Kind</span>
      <select name="kind" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800">
        <option value="reminder">Reminder</option>
        <option value="meeting">Meeting</option>
        <option value="motivation">Motivation</option>
        <option value="custom">Custom</option>
      </select>
    </label>
    <label class="block text-sm md:col-span-2">
      <span class="font-medium">Message</span>
      <textarea name="message" rows="5" required
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800"
        placeholder="Good morning everyone 👋"></textarea>
    </label>
    <div class="md:col-span-2">
      <p class="mb-2 text-xs font-medium uppercase text-slate-400">Insert a template</p>
      <div class="flex flex-wrap gap-2">
        <% templates.forEach(function (t) { %>
          <button type="button" data-template="<%= encodeURIComponent(t.body) %>"
            class="rounded-full border border-slate-300 px-3 py-1 text-xs hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"><%= t.name %></button>
        <% }); %>
      </div>
    </div>
    <div class="flex flex-wrap gap-4 text-sm md:col-span-2">
      <label class="flex items-center gap-2"><input type="checkbox" name="enabled" checked class="rounded" /> Enabled</label>
      <label class="flex items-center gap-2"><input type="checkbox" name="mentionAll" class="rounded" /> Mention everyone</label>
      <label class="flex items-center gap-2"><input type="checkbox" name="skipHolidays" checked class="rounded" /> Skip holidays</label>
      <label class="flex items-center gap-2"><input type="checkbox" name="runOnce" class="rounded" /> Run once</label>
    </div>
    <div class="md:col-span-2">
      <button class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Create schedule</button>
    </div>
  </form>
</section>

<div class="space-y-4">
  <% if (!schedules.length) { %>
    <p class="rounded-2xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">No schedules yet.</p>
  <% } %>
  <% schedules.forEach(function (s) { %>
    <% const group = groups.find(function (g) { return g.id === s.groupId; }); %>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <form method="post" action="/schedules/<%= s.id %>/update" class="grid gap-3 md:grid-cols-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="md:col-span-4 flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="font-semibold"><%= s.name %></h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              <%= group ? group.name : 'unknown group' %> · <%= s.description %>
              <%= s.lastRunAt ? ' · last run ' + formatLocal(s.lastRunAt) : '' %>
            </p>
          </div>
          <div class="flex gap-2">
            <button class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">Save</button>
          </div>
        </div>
        <label class="text-sm md:col-span-1">
          <span class="text-xs font-medium uppercase text-slate-400">Name</span>
          <input name="name" value="<%= s.name %>" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800" />
        </label>
        <label class="text-sm md:col-span-1">
          <span class="text-xs font-medium uppercase text-slate-400">Cron</span>
          <input name="cron" value="<%= s.cron %>" data-cron-input class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm dark:border-slate-700 dark:bg-slate-800" />
          <span class="mt-1 block text-xs text-slate-500 dark:text-slate-400" data-cron-preview><%= s.description %></span>
        </label>
        <label class="text-sm md:col-span-2">
          <span class="text-xs font-medium uppercase text-slate-400">Message</span>
          <textarea name="message" rows="4" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800"><%= s.message %></textarea>
        </label>
        <div class="flex flex-wrap gap-4 text-sm md:col-span-4">
          <label class="flex items-center gap-2"><input type="checkbox" name="enabled" <%= s.enabled ? 'checked' : '' %> class="rounded" /> Enabled</label>
          <label class="flex items-center gap-2"><input type="checkbox" name="mentionAll" <%= s.mentionAll ? 'checked' : '' %> class="rounded" /> Mention everyone</label>
          <label class="flex items-center gap-2"><input type="checkbox" name="skipHolidays" <%= s.skipHolidays ? 'checked' : '' %> class="rounded" /> Skip holidays</label>
        </div>
      </form>
      <div class="mt-3 flex gap-2 border-t border-slate-100 pt-3 dark:border-slate-800">
        <form method="post" action="/schedules/<%= s.id %>/run">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Run now</button>
        </form>
        <form method="post" action="/schedules/<%= s.id %>/toggle">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="enabled" value="<%= s.enabled ? 'false' : 'true' %>" />
          <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"><%= s.enabled ? 'Disable' : 'Enable' %></button>
        </form>
        <form method="post" action="/schedules/<%= s.id %>/delete" onsubmit="return confirm('Delete this schedule?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="rounded-lg border border-red-300 px-3 py-1.5 text-xs text-red-600 hover:bg-red-50 dark:border-red-900 dark:hover:bg-red-950">Delete</button>
        </form>
      </div>
    </section>
  <% }); %>
</div>

<%- include('partials/foot') %>
