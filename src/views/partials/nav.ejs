<div class="min-h-full">
  <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
      <div class="flex items-center gap-3">
        <span class="text-xl">💬</span>
        <a href="/" class="text-sm font-semibold sm:text-base">WhatsApp Group Assistant</a>
        <span id="status-pill" class="hidden rounded-full px-2 py-0.5 text-xs font-medium sm:inline-block">…</span>
      </div>
      <div class="flex items-center gap-2">
        <button id="theme-toggle" type="button" title="Toggle dark mode"
          class="rounded-lg border border-slate-200 px-2 py-1.5 text-sm hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">
          <span class="dark:hidden">🌙</span><span class="hidden dark:inline">☀️</span>
        </button>
        <button id="nav-toggle" type="button" aria-label="Menu"
          class="rounded-lg border border-slate-200 px-2 py-1.5 text-sm md:hidden dark:border-slate-700">☰</button>
        <form method="post" action="/logout" class="hidden md:block">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Sign out</button>
        </form>
      </div>
    </div>
    <nav id="nav-links" class="mx-auto hidden max-w-7xl flex-wrap gap-1 px-4 pb-3 md:flex">
      <% const links = [
        ['overview','/','Overview'],
        ['groups','/groups','Groups'],
        ['schedules','/schedules','Schedules'],
        ['send','/send','Send'],
        ['templates','/templates','Templates'],
        ['analytics','/analytics','Analytics'],
        ['logs','/logs','Logs'],
        ['settings','/settings','Settings']
      ]; %>
      <% links.forEach(function (l) { %>
        <a href="<%= l[1] %>"
           class="rounded-lg px-3 py-1.5 text-sm font-medium <%= active === l[0]
             ? 'bg-emerald-600 text-white'
             : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>"><%= l[2] %></a>
      <% }); %>
      <form method="post" action="/logout" class="md:hidden">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="rounded-lg px-3 py-1.5 text-sm text-slate-600 dark:text-slate-300">Sign out</button>
      </form>
    </nav>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-6">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="mb-4 rounded-xl border px-4 py-3 text-sm <%= flashType === 'error'
        ? 'border-red-200 bg-red-50 text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-200'
        : 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-200' %>">
        <%= flash %>
      </div>
    <% } %>
