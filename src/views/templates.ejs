<%- include('partials/head') %>
<%- include('partials/nav') %>

<h1 class="mb-1 text-xl font-semibold">Message templates</h1>
<p class="mb-4 text-sm text-slate-500 dark:text-slate-400">Categories: <code>reminder</code>, <code>meeting</code>, <code>inactivity</code>, <code>motivation</code>, <code>general</code>. Motivation templates are picked at random by the daily job.</p>

<section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">New template</h2>
  <form method="post" action="/templates" class="grid gap-3 md:grid-cols-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input name="name" required placeholder="Name" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800" />
    <input name="category" placeholder="category" value="general" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800" />
    <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="enabled" checked class="rounded" /> Enabled</label>
    <textarea name="body" rows="4" required placeholder="Message body" class="md:col-span-3 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800"></textarea>
    <div class="md:col-span-3"><button class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Add template</button></div>
  </form>
</section>

<div class="grid gap-4 md:grid-cols-2">
  <% templates.forEach(function (t) { %>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <form method="post" action="/templates/<%= t.id %>/update" class="space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="flex gap-2">
          <input name="name" value="<%= t.name %>" class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800" />
          <input name="category" value="<%= t.category %>" class="w-32 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800" />
        </div>
        <textarea name="body" rows="5" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800"><%= t.body %></textarea>
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="enabled" <%= t.enabled ? 'checked' : '' %> class="rounded" /> Enabled</label>
          <button class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">Save</button>
        </div>
      </form>
      <form method="post" action="/templates/<%= t.id %>/delete" onsubmit="return confirm('Delete this template?')" class="mt-3 border-t border-slate-100 pt-3 dark:border-slate-800">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="text-xs text-red-600 hover:underline">Delete template</button>
      </form>
    </section>
  <% }); %>
</div>

<%- include('partials/foot') %>
