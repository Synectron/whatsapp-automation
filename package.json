{
  "name": "whatsapp-group-assistant",
  "version": "1.0.0",
  "description": "Production-ready WhatsApp Group Assistant: scheduled reminders, AI follow-ups and a configuration dashboard.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && npm run copy:assets",
    "copy:assets": "node scripts/copy-assets.mjs",
    "start": "dotenvx run -- node dist/server.js",
    "dev": "nodemon --watch src --ext ts,ejs --exec \"node scripts/kill-stale.mjs && dotenvx run -- ts-node -r tsconfig-paths/register src/server.ts\"",
    "stop": "node scripts/kill-stale.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "eslint \"{src,tests}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,json}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,json}\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "migrate": "knex --knexfile ./src/database/knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile ./src/database/knexfile.ts migrate:rollback",
    "migrate:make": "knex --knexfile ./src/database/knexfile.ts migrate:make -x ts",
    "seed": "knex --knexfile ./src/database/knexfile.ts seed:run",
    "db:reset": "npm run migrate:rollback -- --all && npm run migrate && npm run seed",
    "prepare:dirs": "node -e \"require('fs').mkdirSync('data',{recursive:true});require('fs').mkdirSync('logs',{recursive:true})\""
  },
  "keywords": [
    "whatsapp",
    "bot",
    "reminders",
    "scheduler",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "knex": "^3.1.0",
    "node-cron": "^3.0.3",
    "openai": "^4.73.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
