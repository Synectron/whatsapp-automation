<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="grid gap-4 lg:grid-cols-3">
  <!-- Connection -->
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-2 dark:border-slate-800 dark:bg-slate-900">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Connection</h2>
        <p class="mt-1 text-2xl font-semibold capitalize"><%= status.replace('_',' ') %></p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          <% if (info.pushname) { %>Signed in as <strong><%= info.pushname %></strong><% } else { %>Not linked yet<% } %>
          <% if (info.connectedSince) { %> · since <%= formatLocal(info.connectedSince) %><% } %>
        </p>
        <% if (dryRun) { %>
          <p class="mt-2 inline-block rounded-lg bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800 dark:bg-amber-950 dark:text-amber-200">DRY RUN — messages are queued but not delivered</p>
        <% } %>
      </div>
      <div class="flex gap-2">
        <form method="post" action="/connection/restart">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Restart</button>
        </form>
        <form method="post" action="/connection/logout" onsubmit="return confirm('Log out of WhatsApp? You will need to scan a new QR code.')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="rounded-lg border border-red-300 px-3 py-2 text-sm text-red-600 hover:bg-red-50 dark:border-red-900 dark:hover:bg-red-950">Log out</button>
        </form>
      </div>
    </div>

    <div class="mt-5 flex flex-col items-center gap-3 rounded-xl border border-dashed border-slate-300 p-5 dark:border-slate-700" id="qr-panel">
      <% if (qr) { %>
        <p class="text-sm text-slate-500 dark:text-slate-400">Open WhatsApp → Linked devices → Link a device</p>
        <img src="<%= qr %>" alt="WhatsApp QR code" class="h-56 w-56 rounded-lg bg-white p-2" />
      <% } else if (connected) { %>
        <p class="text-sm text-emerald-600 dark:text-emerald-400">✅ Connected — no QR code needed.</p>
      <% } else { %>
        <p class="text-sm text-slate-500 dark:text-slate-400">Waiting for a QR code… this page refreshes automatically.</p>
      <% } %>
    </div>
  </section>

  <!-- Stats -->
  <div class="grid gap-4">
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">At a glance</h2>
      <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
        <div><dt class="text-slate-500 dark:text-slate-400">Groups</dt><dd class="text-xl font-semibold"><%= counts.total %></dd></div>
        <div><dt class="text-slate-500 dark:text-slate-400">Enabled</dt><dd class="text-xl font-semibold text-emerald-600"><%= counts.enabled %></dd></div>
        <div><dt class="text-slate-500 dark:text-slate-400">Queue pending</dt><dd class="text-xl font-semibold"><%= queue.pending %></dd></div>
        <div><dt class="text-slate-500 dark:text-slate-400">Failed</dt><dd class="text-xl font-semibold <%= queue.failed ? 'text-red-600' : '' %>"><%= queue.failed %></dd></div>
        <div><dt class="text-slate-500 dark:text-slate-400">Sent (1h)</dt><dd class="text-xl font-semibold"><%= queue.sentLastHour %></dd></div>
        <div><dt class="text-slate-500 dark:text-slate-400">Cron jobs</dt><dd class="text-xl font-semibold"><%= scheduler.jobs %></dd></div>
      </dl>
      <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
        AI: <strong><%= ai.provider %></strong> <%= ai.ready ? '(ready)' : '(not configured)' %> ·
        Scheduler <%= scheduler.running ? 'running' : 'stopped' %>
      </p>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Enabled groups</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <% const enabled = groups.filter(function (g) { return g.enabled; }); %>
        <% if (!enabled.length) { %>
          <li class="text-slate-500 dark:text-slate-400">No groups enabled yet — <a class="underline" href="/groups">enable one</a>.</li>
        <% } %>
        <% enabled.slice(0, 8).forEach(function (g) { %>
          <li class="flex items-center justify-between gap-2">
            <span class="truncate"><%= g.name %></span>
            <span class="shrink-0 text-xs text-slate-400"><%= g.lastMessageAt ? formatLocal(g.lastMessageAt) : 'no activity' %></span>
          </li>
        <% }); %>
      </ul>
    </section>
  </div>
</div>

<section class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Recent activity</h2>
    <a href="/logs" class="text-sm text-emerald-600 hover:underline">All logs →</a>
  </div>
  <div class="mt-3 overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="text-xs uppercase text-slate-400">
        <tr><th class="py-2 pr-4">Time</th><th class="py-2 pr-4">Event</th><th class="py-2">Details</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% recentLogs.forEach(function (l) { %>
          <tr>
            <td class="whitespace-nowrap py-2 pr-4 text-slate-500"><%= formatLocal(l.timestamp) %></td>
            <td class="whitespace-nowrap py-2 pr-4"><span class="rounded bg-slate-100 px-2 py-0.5 text-xs dark:bg-slate-800"><%= l.event %></span></td>
            <td class="py-2 text-slate-500 dark:text-slate-400"><span class="line-clamp-2 break-all"><%= l.details || '—' %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/foot') %>
