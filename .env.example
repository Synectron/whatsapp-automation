# â”€â”€â”€ Server â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=4000
HOST=0.0.0.0
# development | production â€” set production only when you deploy.
NODE_ENV=development
# Public base URL of the dashboard (used for absolute links only)
BASE_URL=http://localhost:4000

# â”€â”€â”€ Localisation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
TIMEZONE=Asia/Kolkata
LOCALE=en-IN

# â”€â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# sqlite (default) or postgres
DB_CLIENT=sqlite
# For sqlite this is a file path; for postgres a full connection string.
#   sqlite   -> ./data/app.sqlite
#   postgres -> postgres://user:pass@host:5432/whatsapp_assistant
DATABASE_URL=./data/app.sqlite
DB_POOL_MIN=1
DB_POOL_MAX=10
# Run pending migrations automatically on boot
DB_AUTO_MIGRATE=true

# â”€â”€â”€ Dashboard authentication â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Leave DASHBOARD_PASSWORD empty to get the guided first-boot setup wizard, which
# creates the admin account in the database. Set it to skip the wizard entirely
# (useful for declarative/IaC deployments) â€” env credentials always take priority.
DASHBOARD_USERNAME=admin
# Plain password (hashed in memory at boot). Prefer DASHBOARD_PASSWORD_HASH in prod.
DASHBOARD_PASSWORD=change-me-please
# Optional pre-computed bcrypt hash. Takes precedence over DASHBOARD_PASSWORD.
DASHBOARD_PASSWORD_HASH=
# 32+ char random string: `openssl rand -hex 32`
SESSION_SECRET=please-change-this-to-a-long-random-string-min-32-chars
SESSION_TTL_HOURS=12
# Set true when serving over HTTPS
SESSION_SECURE_COOKIE=false
# Static token for machine-to-machine REST calls (X-API-Key header). Empty disables it.
API_KEY=

# Country code assumed when you type an individual number without one, e.g. 91
# for India. Leave empty to require a full international number every time.
DEFAULT_COUNTRY_CODE=91

# â”€â”€â”€ WhatsApp â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
WHATSAPP_SESSION_PATH=./data/wwebjs_auth
WHATSAPP_CLIENT_ID=default
WHATSAPP_HEADLESS=true
# Comma-separated extra chromium args, e.g. --no-sandbox,--disable-dev-shm-usage
WHATSAPP_PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage
# Path to a system chromium/chrome binary (required inside the Docker image)
WHATSAPP_EXECUTABLE_PATH=
WHATSAPP_RECONNECT_DELAY_MS=5000
WHATSAPP_MAX_RECONNECT_ATTEMPTS=20
# Disable actual sending (dry-run). Messages are queued and logged only.
WHATSAPP_DRY_RUN=false

# â”€â”€â”€ Outgoing message queue â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_MAX_ATTEMPTS=5
QUEUE_BASE_BACKOFF_MS=5000
QUEUE_MAX_BACKOFF_MS=900000
# Token bucket: max messages per window
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_MS=60000
# Minimum gap between two consecutive sends
RATE_LIMIT_MIN_GAP_MS=1500

# â”€â”€â”€ Scheduler â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SCHEDULER_ENABLED=true
# Skip scheduled reminders that fall on a configured holiday
HOLIDAY_AWARENESS_ENABLED=true
# Skip reminders on weekends (0=Sun..6=Sat), comma separated. Empty = never skip.
SKIP_WEEKDAYS=

# â”€â”€â”€ Inactivity detection â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
INACTIVITY_ENABLED=true
INACTIVITY_HOURS=6
INACTIVITY_CHECK_CRON=0 * * * *
# Do not nudge outside these hours (local time)
INACTIVITY_QUIET_START=22
INACTIVITY_QUIET_END=8

# â”€â”€â”€ Daily motivation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
MOTIVATION_ENABLED=false
MOTIVATION_CRON=0 9 * * 1-5

# â”€â”€â”€ AI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# gemini | openai | none
AI_PROVIDER=gemini
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AI_MAX_TOKENS=400
AI_TEMPERATURE=0.4
AI_TIMEOUT_MS=20000
# Max AI follow-up replies per group per hour (anti-spam)
AI_MAX_REPLIES_PER_HOUR=6
# Minimum characters in an inbound message before AI considers replying
AI_MIN_MESSAGE_LENGTH=8
# Weekly AI summary
AI_WEEKLY_SUMMARY_ENABLED=false
AI_WEEKLY_SUMMARY_CRON=0 17 * * 5

# â”€â”€â”€ Logging â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=14d
LOG_TO_CONSOLE=true
# Rows kept in the `logs` table before pruning
LOG_DB_RETENTION=5000

# â”€â”€â”€ Backup â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
BACKUP_DIR=./backups
